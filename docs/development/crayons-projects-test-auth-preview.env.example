# Test-only Preview example. Add these variables ONLY to the test PR branch scope.
# Never add these to Production or use this file as a production .env.
# All key names must match src/lib/auth/verify.server.ts and src/lib/supabase.ts.
# Publishable keys are public API identifiers, not secret/service-role keys.
VITE_TEST_AUTH_ENABLED=true
VITE_TEST_AUTH_SUPABASE_URL=https://jbymleftneggcgutlcqu.supabase.co
VITE_TEST_AUTH_SUPABASE_PUBLISHABLE_KEY=<TEST_PROJECT_PUBLISHABLE_KEY>
TEST_AUTH_ENABLED=true
TEST_AUTH_SUPABASE_URL=https://jbymleftneggcgutlcqu.supabase.co
TEST_AUTH_SERVER_PUBLISHABLE_KEY=<TEST_PROJECT_PUBLISHABLE_KEY>

# PostgreSQL session resolution is separate from Supabase Auth.
# Do not set DATABASE_URL / POSTGRES_URL here until a reviewed, project-specific
# Postgres connection string for jbymleftneggcgutlcqu has been issued and confirmed.
