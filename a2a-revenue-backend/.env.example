# Copy to .env locally or configure as server environment variables.
# Never commit real secrets and NEVER put SUPABASE_SECRET_KEY in browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Comma-separated Supabase Auth user UUIDs allowed to administer this dashboard:
A2A_ADMIN_USER_IDS=REPLACE_WITH_AUTH_USER_UUID
# Exact browser origin(s), comma-separated:
CORS_ORIGINS=http://localhost:5173,https://your-dashboard-domain.example
PORT=3000
